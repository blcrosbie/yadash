{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yadash.dev/schema/v0.1/dashboard.schema.json",
  "title": "yadash dashboard",
  "description": "Declarative description of a dashboard. Compiles to a static web app.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dashboard"],
  "properties": {
    "version": { "const": 1, "description": "Spec version. Always 1 for v0.1." },
    "dashboard": { "$ref": "#/$defs/dashboard" }
  },
  "$defs": {
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "widgets"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable slug. Used for the output folder and the embed id."
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "theme": { "enum": ["light", "dark", "auto"], "default": "auto" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "layout": { "$ref": "#/$defs/layout" },
        "data": {
          "type": "object",
          "minProperties": 1,
          "description": "Named data sources. Metrics and widgets refer to these by name.",
          "patternProperties": { "^[a-z][a-z0-9_]*$": { "$ref": "#/$defs/source" } },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "description": "Named measures. Define once, reuse in every widget.",
          "patternProperties": { "^[a-z][a-z0-9_]*$": { "$ref": "#/$defs/metric" } },
          "additionalProperties": false
        },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "widgets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/widget" } }
      }
    },

    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 24, "default": 12 },
        "gap": { "type": "integer", "minimum": 0, "maximum": 64, "default": 16 },
        "row_height": { "type": "integer", "minimum": 16, "maximum": 200, "default": 64 },
        "max_width": { "type": "integer", "minimum": 480, "maximum": 4096 }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["inline", "csv", "json", "api"],
          "description": "inline: rows in the YAML. csv/json: file copied into the build. api: fetched at view time."
        },
        "path": { "type": "string", "description": "csv/json only: path relative to this YAML file." },
        "url": { "type": "string", "description": "api only: absolute or site-relative URL returning JSON rows." },
        "rows": { "type": "array", "items": { "type": "object" }, "description": "inline only." },
        "root": { "type": "string", "description": "api/json only: dotted path to the array inside the response, e.g. data.rows." },
        "headers": { "type": "object", "description": "api only: static request headers. Never put secrets here." },
        "refresh": { "type": "integer", "minimum": 5, "description": "api only: re-fetch every N seconds." },
        "date_fields": { "type": "array", "items": { "type": "string" }, "description": "Fields to parse as dates." },
        "number_fields": { "type": "array", "items": { "type": "string" }, "description": "Fields to coerce to numbers. csv only; JSON keeps its own types." }
      }
    },

    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agg"],
      "properties": {
        "agg": { "enum": ["count", "sum", "avg", "min", "max", "distinct_count", "ratio"] },
        "field": { "type": "string", "description": "Required for every agg except count." },
        "of": { "type": "string", "description": "ratio only: the denominator field." },
        "source": { "type": "string", "description": "Data source name. Defaults to the first source." },
        "label": { "type": "string" },
        "format": { "enum": ["number", "currency", "percent", "compact", "duration"], "default": "number" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "currency": { "type": "string", "description": "ISO code, e.g. USD. Only meaningful with format: currency." },
        "where": { "$ref": "#/$defs/where", "description": "Row filter applied to this metric only." },
        "description": { "type": "string" }
      }
    },

    "where": {
      "type": "array",
      "description": "Row conditions, ANDed together.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field"],
        "properties": {
          "field": { "type": "string" },
          "op": {
            "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "not_in", "contains", "is_null", "not_null"],
            "default": "eq"
          },
          "value": {}
        }
      }
    },

    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "field": { "type": "string" },
        "source": { "type": "string" },
        "type": { "enum": ["select", "multiselect", "date_range", "search"], "default": "select" },
        "label": { "type": "string" },
        "default": {},
        "options": { "type": "array", "description": "Fixed choices. Omit to derive them from the data." }
      }
    },

    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": {
          "enum": ["kpi", "line", "area", "bar", "stacked_bar", "hbar", "pie", "donut", "scatter", "table", "markdown"],
          "description": "Semantic widget vocabulary. references/widgets.md says what each one needs."
        },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "position": {
          "type": "array",
          "description": "[column, row], 1-based, in grid units.",
          "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "description": "[width, height] in grid units. One height unit = layout.row_height.",
          "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
          "minItems": 2,
          "maxItems": 2
        },
        "source": { "type": "string" },
        "metric": { "type": "string", "description": "kpi: the single metric to show." },
        "metrics": { "type": "array", "items": { "type": "string" }, "description": "Series or table columns, by metric name." },
        "x": { "$ref": "#/$defs/axis" },
        "y": { "$ref": "#/$defs/axis" },
        "series": { "$ref": "#/$defs/dimension", "description": "Split into one series per value of this field." },
        "dimension": { "$ref": "#/$defs/dimension", "description": "pie/donut/bar/hbar category." },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" }, "description": "table only: grouping columns." },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" }, "description": "table only: explicit column control." },
        "sort": { "$ref": "#/$defs/sort" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "where": { "$ref": "#/$defs/where" },
        "compare": {
          "enum": ["previous_period", "none"],
          "default": "none",
          "description": "kpi only: show the delta against the window immediately before the active date range."
        },
        "target": { "type": "number", "description": "kpi only." },
        "thresholds": { "type": "array", "items": { "$ref": "#/$defs/threshold" } },
        "smooth": { "type": "boolean" },
        "show_legend": { "type": "boolean", "default": true },
        "show_labels": { "type": "boolean", "default": false },
        "text": { "type": "string", "description": "markdown only." },
        "format": { "enum": ["number", "currency", "percent", "compact", "duration"] },
        "empty_message": { "type": "string" }
      }
    },

    "axis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "metric": { "type": "string" },
        "metrics": { "type": "array", "items": { "type": "string" } },
        "bucket": { "enum": ["hour", "day", "week", "month", "quarter", "year"], "description": "Time bucketing for a date field." },
        "label": { "type": "string" },
        "format": { "enum": ["number", "currency", "percent", "compact", "duration", "date"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "sort": { "enum": ["asc", "desc", "none"] }
      }
    },

    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string" },
        "label": { "type": "string" },
        "bucket": { "enum": ["hour", "day", "week", "month", "quarter", "year"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Keep the top N values, group the rest as Other." }
      }
    },

    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": { "type": "string", "description": "A dimension field name or a metric name." },
        "label": { "type": "string" },
        "format": { "enum": ["number", "currency", "percent", "compact", "duration", "date", "text"] },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "align": { "enum": ["left", "right", "center"] },
        "bar": { "type": "boolean", "description": "Draw an in-cell bar scaled to the column max." },
        "thresholds": { "type": "array", "items": { "$ref": "#/$defs/threshold" } }
      }
    },

    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by"],
      "properties": {
        "by": { "type": "string", "description": "Metric name or dimension field." },
        "direction": { "enum": ["asc", "desc"], "default": "desc" }
      }
    },

    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "below": { "type": "number" },
        "above": { "type": "number" },
        "state": { "enum": ["good", "warn", "bad", "neutral"] },
        "label": { "type": "string" }
      }
    }
  }
}
